# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =============================================================
# LIVETRIGGER AI - CONFIGURACIÓN DE DESPLIEGUE EN PRODUCCIÓN
# =============================================================

# Puerto de escucha HTTP del servidor Node.js (por defecto 3000)
PORT=3000

# Entorno de ejecución: 'production' para despliegues en Internet o 'development'
NODE_ENV=production

# Clave secreta para la firma de tokens JWT de sesión (Genera una clave aleatoria de 32+ caracteres)
JWT_SECRET=cambia_esta_clave_secreta_por_una_aleatoria_muy_segura_en_produccion

# Credenciales de la cuenta administradora inicial
# SEGURIDAD: Reemplaza ADMIN_PASSWORD con una contraseña robusta propia de al menos 10 caracteres.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@livetrigger.local
ADMIN_PASSWORD=tu_contrasena_administrador_fuerte_aqui_minimo_10_caracteres

# Token de seguridad para verificar solicitudes de webhooks externos de TikTok
TIKTOK_WEBHOOK_SECRET=tu_secreto_webhook_tiktok_opcional

# =============================================================
# CONEXIÓN TIKTOK LIVE & EULER STREAM SIGN API (BACKEND SOLAMENTE)
# =============================================================
# Clave API para Euler Stream Sign API (https://www.eulerstream.com/docs/quickstart).
# Permite firmar solicitudes Webcast y resolver salas de TikTok LIVE sin bloqueos ni captchas en entornos cloud/datacenter.
# NUNCA compartas ni expongas esta clave en el frontend ni en variables VITE_*.
EULER_STREAM_API_KEY=tu_clave_euler_stream_aqui

# Directorio de persistencia para base de datos y respaldos en disco (útil para Docker volumes)
DATA_DIR=/app/data
