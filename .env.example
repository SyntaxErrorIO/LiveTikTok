# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =============================================================
# LIVETRIGGER AI - CONFIGURACIÓN DE DESPLIEGUE EN PRODUCCIÓN
# =============================================================

# Puerto de escucha HTTP del servidor Node.js (por defecto 3000)
PORT=3000

# Entorno de ejecución: 'production' para despliegues en Internet o 'development'
NODE_ENV=production

# Clave secreta para la firma de tokens JWT de sesión (OBLIGATORIA en producción, mínimo 32 caracteres).
# Genera una clave criptográfica segura ejecutando:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# La sesión se emite mediante Cookie HttpOnly (SameSite=Strict, Secure en producción) protegida contra XSS y CSRF.
JWT_SECRET=

# Credenciales de la cuenta administradora inicial
# SEGURIDAD: Define una contraseña robusta propia de al menos 10 caracteres.
# No uses valores de ejemplo prohibidos (como ADMIN_PASSWORD=tu_contrasena_administrador_fuerte_aqui_minimo_10_caracteres) ya que el servidor denegará el arranque en producción.
# Puedes generar una contraseña fuerte con:
# node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@livetrigger.local
ADMIN_PASSWORD=

# Control de registro público: 'true' para permitir que cualquiera se registre, 'false' para cerrarlo.
# Por defecto es 'true' en desarrollo y 'false' si se define o ejecuta en producción (solo administradores pueden crear cuentas).
ALLOW_REGISTRATION=false

# Token de seguridad opcional para verificar solicitudes de webhooks externos de TikTok (Authorization: Bearer o x-webhook-secret)
# Para generarlo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TIKTOK_WEBHOOK_SECRET=

# =============================================================
# CONEXIÓN TIKTOK LIVE & EULER STREAM SIGN API (BACKEND SOLAMENTE)
# =============================================================
# Clave API para Euler Stream Sign API (https://www.eulerstream.com/docs/quickstart).
# Permite firmar solicitudes Webcast y resolver salas de TikTok LIVE sin bloqueos ni captchas en entornos cloud/datacenter.
# NUNCA compartas ni expongas esta clave en el frontend ni en variables VITE_*. Déjala vacía si no usas Euler Stream.
EULER_STREAM_API_KEY=

# =============================================================
# PERSISTENCIA SQLITE Y DIRECTORIO DE DATOS
# =============================================================
# Directorio donde se almacena la base de datos SQLite (livetrigger.db), respaldos y snapshots.
# En Docker, mapea el volumen montado en /app/data para conservar usuarios, reglas, metas y rankings.
DATA_DIR=/app/data

# =============================================================
# SEGURIDAD CSP Y ACCESO EXTERNO
# =============================================================
# Orígenes adicionales permitidos para incrustar la app en iframes (directiva frame-ancestors en Content-Security-Policy).
# Por defecto restringido estrictamente a 'self'. Para entornos como AI Studio o plataformas externas:
ALLOWED_FRAME_ANCESTORS=https://ai.google.dev https://aistudio.google.com

# =============================================================
# OVERLAY OBS STUDIO (MODO OVERLAY)
# =============================================================
# En OBS Browser Source, se utiliza la URL: http://<tu-host>:3000/?mode=overlay&overlayToken=<token_del_usuario>
# El overlay consulta el endpoint de solo lectura GET /api/overlay/state?overlayToken=... y se conecta al stream SSE
# para mantener la meta de diamantes y el top 5 de donadores sincronizados en tiempo real y persistentes tras recargar la fuente.
